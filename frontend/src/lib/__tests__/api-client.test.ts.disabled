import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
import axios from "axios";

// Mock localStorage
vi.stubGlobal("localStorage", {
  getItem: vi.fn(),
  setItem: vi.fn(),
  removeItem: vi.fn(),
  clear: vi.fn(),
});

// Mock axios create
vi.mock("axios", () => ({
  default: {
    create: vi.fn(() => ({
      interceptors: {
        request: { use: vi.fn() },
        response: { use: vi.fn() },
      },
    })),
  },
}));

// Mock environment variables
vi.stubGlobal("import", {
  meta: {
    env: {
      VITE_API_URL: "https://api.shortking.com/v1",
    },
  },
});

describe("API Client", () => {
  let originalConsoleLog: typeof console.log;

  beforeEach(() => {
    vi.resetAllMocks();

    // Store original console.log
    originalConsoleLog = console.log;

    // Clear the module cache to force re-import
    vi.resetModules();
  });

  afterEach(() => {
    // Restore console.log
    console.log = originalConsoleLog;
    vi.restoreAllMocks();
  });

  it("should create axios instance with correct config", async () => {
    // Import the module
    await import("../api-client");

    // Verify axios.create was called with the correct config
    expect(axios.create).toHaveBeenCalledWith({
      baseURL: "https://api.shortking.com/v1",
      headers: {
        "Content-Type": "application/json",
      },
    });
  });

  it("should set up request interceptor for adding auth token", async () => {
    // Import the module
    const { apiClient } = await import("../api-client");

    // Verify that the request interceptor was set up
    expect(apiClient.interceptors.request.use).toHaveBeenCalled();
  });

  it("should set up response interceptor for error handling", async () => {
    // Import the module
    const { apiClient } = await import("../api-client");

    // Verify that the response interceptor was set up
    expect(apiClient.interceptors.response.use).toHaveBeenCalled();
  });
});
